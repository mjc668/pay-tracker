POSTGRES_USER=paytracker
POSTGRES_PASSWORD=changeme
POSTGRES_DB=paytracker
# For local dev without Docker. In Docker Compose, the backend's DATABASE_URL is
# overridden via the environment: block in docker-compose.yml (host = postgres service name).
DATABASE_URL=postgresql://paytracker:changeme@localhost:5432/paytracker

# Backend URL as seen by the *browser*. Two deployment modes:
#   - Direct: point NEXT_PUBLIC_API_URL at the backend
#     (default http://localhost:8010 for local dev).
#   - Caddy same-origin: leave NEXT_PUBLIC_API_URL empty and set
#     API_PREFIX=/api so the proxy forwards /api/* to the backend.
NEXT_PUBLIC_API_URL=http://localhost:8010
# Path prefix under which the backend is served (see NEXT_PUBLIC_API_URL above).
API_PREFIX=
NEXT_PUBLIC_APP_VERSION=dev
# Deployment note: pin a concrete tag (e.g. PAY_TRACKER_VERSION=1.1.0) rather
# than relying on :latest when using docker-compose.prod.yml.
# Seconds between proactive session-expiry checks on an idle authenticated tab.
NEXT_PUBLIC_SESSION_HEARTBEAT_SECONDS=180

# --- Backend / API ---
# set to production in prod; disables API docs & enables the default-secret guard
ENVIRONMENT=development
# set true ONLY when serving via HTTPS/Caddy; over plain HTTP browsers reject
# Secure cookies and login appears to succeed then bounces back to /login
COOKIE_SECURE=false
# set true behind Caddy/nginx so rate limiting uses the real client IP from X-Forwarded-For
TRUST_PROXY=false

# Rate limiting (in-memory, per-process)
# login: 10/min | register: 25/hour | forgot-password: 5/hour
# reset-password: 5/10min | change-password: 5/hour
# change-email: 5/hour | send-now: 2/hour

JWT_SECRET=changeme-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Reminders (optional, nice-to-have) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASSWORD=changeme
# REMINDER_FROM=noreply@yourdomain.com
# Domains whose users are silently skipped by the email scheduler (JSON array).
# Default already blocks test.com and example.com.
# EMAIL_BLOCKED_DOMAINS=["test.com","example.com"]

# --- Apprise notifications (optional; preferred over SMTP when configured) ---
# When APPRISE_BASE_URL and a target (key or urls) are set, reminders and the
# monthly summary are sent via Apprise; email is only the fallback.
# Reachability: the backend container must be able to reach the Apprise API.
# Use the host IP or a shared Docker network — "localhost" would point at the
# backend container itself.
# Stateful mode (recommended): configure targets inside the Apprise container.
# APPRISE_BASE_URL=http://10.112.200.5:8000
# APPRISE_KEY=paytracker
# Stateless mode: pass target URLs directly (space/comma separated).
# APPRISE_KEY wins over APPRISE_URLS when both are set.
# APPRISE_URLS="ntfy://topic discord://webhook_id/webhook_token"
# APPRISE_TIMEOUT_SECONDS=10

# --- Password reset ---
APP_BASE_URL=http://localhost:3010
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# --- Restore safety net ---
# Days a pre-restore snapshot stays recoverable before the cleanup job deletes it.
RESTORE_SNAPSHOT_RETENTION_DAYS=7
